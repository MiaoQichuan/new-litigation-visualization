# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---- 临时渲染产物 ----
final.svg
final.png
final.pdf
*__png.pdf
/out/
# 在模块目录里照 README 跑示例（make.py -o out/…）留下的产物
plugins/mqc-nlv/skills/*/out/
# 法律图表大师 pack_standalone.py 默认把单独安装包写在 dist/（发版附件，不入库）
plugins/mqc-nlv/skills/*/dist/
/output/
/renders/
/scratch/
*.tmp.svg
*.tmp.png

# 可编辑交付件(渲染产物,不入库)
final.pptx
final.vsdx
final.drawio
final.drawio.svg
*-draft.*

# ---- 管线的中间产物（时间轴大师）----
# pipeline.py 把这五份写在**当前工作目录**。在仓库里跑一次流程就会留下它们，
# 而它们是某一次办案的中间状态（含材料原句），既不该入库也不该被别人看到。
state.json
verdicts.json
parts.json
skeleton.json
items.json
*-trace.json
*-溯源索引.docx
# 法律图表大师的逐格溯源（<名>.trace.json）：列着案号、编号，同样是办案材料，不入库
*.trace.json

# 法律课件大师：几方同时写课件时的锁文件与暂存文件（在用户的课件文件夹里，不入库）
.nlv-lock
*.nlv-new
# 独立运行的编辑器（studio.py --detach）记下的网址、进程号与日志
.nlv-studio.json
.nlv-studio.log

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 打包时 macOS 带进来的元数据
__MACOSX/
